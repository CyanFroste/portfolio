---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const data = await getCollection('blogs')
---

<Layout
  title="Cyan Froste's Blogs"
  description="Blogs by Cyan Froste about Software Development, Gaming, Art and everything else">
  <div class="flex flex-col pt-8 lg:pt-20 w-full max-w-6xl mx-auto">
    <h1
      class="text-4xl lg:text-5xl font-display uppercase leading-normal text-center
      my-8 lg:my-20 bg-gradient-to-b from-orange-600 to-orange-200 bg-clip-text text-transparent">
      BLOGS
    </h1>

    <ul class="flex flex-col">
      {
        data.map(item => (
          <li class="w-full p-4 lg:p-0">
            <a
              href={`${import.meta.env.BASE_URL}/blogs/${item.id}`}
              class="p-4 lg:p-6 flex flex-col w-full bg-cyan-950/25 hover:bg-cyan-900/25 
              transition-colors rounded-md border border-cyan-950">
              <h3 class="text-xl lg:text-2xl text-cyan-200 mb-2">{item.data.title}</h3>
              <p class="text-zinc-300 mb-8 text-sm lg:text-base">{item.data.description}</p>

              <p class="text-xs lg:text-sm text-zinc-500 ml-auto py-1">
                by <span class="text-zinc-400">{item.data.author}</span> on {item.data.date.toLocaleDateString()}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
